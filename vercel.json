{
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    { "source": "/about/(.*)", "destination": "/about/index.html" },
    { "source": "/ventures/ziggers/(.*)", "destination": "/ventures/ziggers/index.html" },
    { "source": "/ventures/loopmemory/(.*)", "destination": "/ventures/loopmemory/index.html" },
    { "source": "/writing/(.*)", "destination": "/writing/index.html" },
    { "source": "/contact/(.*)", "destination": "/contact/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
