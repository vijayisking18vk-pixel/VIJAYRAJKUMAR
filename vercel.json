{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "vijayrajkumar.vercel.app"
        }
      ],
      "destination": "https://www.vijayrajkumar.in/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(.*)\\.vercel\\.app"
        }
      ],
      "destination": "https://www.vijayrajkumar.in/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "vijayrajkumar.in"
        }
      ],
      "destination": "https://www.vijayrajkumar.in/$1",
      "permanent": true
    },
    {
      "source": "/vijayrajkumar",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/vijayrajkumar/(.*)",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/catering-workers-in-chennai",
      "destination": "/writing/catering-workers-in-chennai/",
      "permanent": true
    },
    {
      "source": "/catering-workers-in-chennai/(.*)",
      "destination": "/writing/catering-workers-in-chennai/",
      "permanent": true
    },
    {
      "source": "/startup-builder-venture-builder-india",
      "destination": "/writing/startup-builder-venture-builder-india/",
      "permanent": true
    },
    {
      "source": "/startup-builder-venture-builder-india/(.*)",
      "destination": "/writing/startup-builder-venture-builder-india/",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/about/(.*)", "destination": "/about/index.html" },
    { "source": "/ventures/ziggers/(.*)", "destination": "/ventures/ziggers/index.html" },
    { "source": "/ventures/loopmemory/(.*)", "destination": "/ventures/loopmemory/index.html" },
    { "source": "/ventures/(.*)", "destination": "/ventures/index.html" },
    { "source": "/writing/startup-builder-venture-builder-india/(.*)", "destination": "/writing/startup-builder-venture-builder-india/index.html" },
    { "source": "/writing/gig-marketplace-chennai/(.*)", "destination": "/writing/gig-marketplace-chennai/index.html" },
    { "source": "/writing/ai-persistent-context-architecture/(.*)", "destination": "/writing/ai-persistent-context-architecture/index.html" },
    { "source": "/writing/geopolitics-defence-venture-building/(.*)", "destination": "/writing/geopolitics-defence-venture-building/index.html" },
    { "source": "/writing/catering-workers-in-chennai/(.*)", "destination": "/writing/catering-workers-in-chennai/index.html" },
    { "source": "/writing/(.*)", "destination": "/writing/index.html" },
    { "source": "/events/(.*)", "destination": "/events/index.html" },
    { "source": "/contact/(.*)", "destination": "/contact/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/frames/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/parallax/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(.*)\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
